# ================================================================
# EMPIRE OS — free-claude-code proxy configuration TEMPLATE
# Multi-model gateway with OpenRouter and NVIDIA NIM
# ================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your API keys from the provider dashboards
# 3. Configure model routing (MODEL_OPUS, MODEL_SONNET, MODEL_HAIKU)
# 4. Start the proxy: fcc-server
# 5. Open Admin UI at http://localhost:8082/admin

# ── API Keys ────────────────────────────────────────────────────
# NVIDIA NIM — Get key from https://build.nvidia.com/settings/api-keys
NVIDIA_NIM_API_KEY=

# OpenRouter — Get key from https://openrouter.ai/workspaces/default/keys
OPENROUTER_API_KEY=

# Optional providers
GLM_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
WAFLE_API_KEY=
OPENCODE_API_KEY=
ZAI_API_KEY=

# ── Anthropic Auth (Local Proxy) ─────────────────────────────────
# ANTHROPIC_AUTH_TOKEN: Any string to use locally (e.g., "freecc")
# ANTHROPIC_BASE_URL: Always http://localhost:PORT
ANTHROPIC_AUTH_TOKEN=freecc
ANTHROPIC_BASE_URL=http://localhost:8082

# ── Server ──────────────────────────────────────────────────────
PORT=8082
HOST=0.0.0.0

# ── Model Assignments ────────────────────────────────────────────
# These map Claude Code's model tiers to your chosen providers.
# Format: provider/model-slug (e.g., nvidia_nim/z-ai/glm4.7)

# Fallback for unrecognized model names
MODEL=open_router/openai/gpt-4-turbo

# Claude Code Opus (strongest) → NVIDIA NIM Kimi
MODEL_OPUS=nvidia_nim/moonshotai/kimi-k2.6

# Claude Code Sonnet (mid-tier) → OpenRouter Claude Sonnet
MODEL_SONNET=open_router/anthropic/claude-3.5-sonnet

# Claude Code Haiku (fast/cheap) → OpenRouter GPT-4 Mini
MODEL_HAIKU=open_router/openai/gpt-4-mini

# ── Backup Provider Failover Chain ───────────────────────────────
# When a provider fails, try next in list. Format: comma-separated provider names
BACKUP_OPUS_PROVIDERS=nvidia_nim,open_router
BACKUP_SONNET_PROVIDERS=open_router,nvidia_nim
BACKUP_HAIKU_PROVIDERS=open_router,nvidia_nim

# ── Model Discovery ─────────────────────────────────────────────
# Enable for Claude Code /model picker to show all available models
ENABLE_MODEL_DISCOVERY=true
SYNCHRONOUS_MODEL_DISCOVERY=false

# ── Health Checking & Circuit Breaker ────────────────────────────
DISABLE_PROVIDER_HEALTH_CHECKING=false
ENABLE_AUTO_FAILOVER=true
FAILOVER_RETRY_COUNT=3
FAILOVER_RETRY_DELAY_MS=1000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_MS=30000

# ── Rate Limiting ───────────────────────────────────────────────
# Global defaults
PROVIDER_RATE_LIMIT=30
PROVIDER_RATE_WINDOW=60
PROVIDER_MAX_CONCURRENCY=5

# Provider-specific overrides
NVIDIA_NIM_RATE_LIMIT=40
NVIDIA_NIM_RATE_WINDOW=60
OPENROUTER_RATE_LIMIT=20
OPENROUTER_RATE_WINDOW=60

# ── HTTP Timeouts ───────────────────────────────────────────────
HTTP_READ_TIMEOUT=600
HTTP_WRITE_TIMEOUT=120
HTTP_CONNECT_TIMEOUT=60

# ── Extended Thinking (Extended Thinking / Reasoning) ───────────
ENABLE_MODEL_THINKING=false
ENABLE_OPUS_THINKING=
ENABLE_SONNET_THINKING=
ENABLE_HAIKU_THINKING=

# ── HTTP Proxies (outbound) ────────────────────────────────────
NVIDIA_NIM_PROXY=
OPENROUTER_PROXY=

# ── Messaging & Bots ────────────────────────────────────────────
MESSAGING_PLATFORM=none
# MESSAGING_PLATFORM=discord
# MESSAGING_PLATFORM=telegram

DISCORD_BOT_TOKEN=
ALLOWED_DISCORD_CHANNELS=

TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=

# ── Voice Transcription ────────────────────────────────────────
VOICE_NOTE_ENABLED=false
WHISPER_DEVICE=cpu
WHISPER_MODEL=base
HF_TOKEN=

# ── Diagnostics (keep false in production) ───────────────────────
LOG_API_ERROR_TRACEBACKS=false
DEBUG_PLATFORM_EDITS=false
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
LOG_RAW_MESSAGING_CONTENT=false
LOG_RAW_CLI_DIAGNOSTICS=false
LOG_MESSAGING_ERROR_DETAILS=false

# ── Local Model Servers ────────────────────────────────────────
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
OLLAMA_BASE_URL=http://localhost:11434

# ── Web Tools ──────────────────────────────────────────────────
ENABLE_WEB_SERVER_TOOLS=false
WEB_FETCH_ALLOWED_SCHEMES=http,https
WEB_FETCH_ALLOW_PRIVATE_NETWORK=false

# ── Paths ──────────────────────────────────────────────────────
CLAUDE_WORKSPACE=./agent_workspace
ALLOWED_DIR=
