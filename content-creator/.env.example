# ── FAL.ai (AI Studio — image & video generation) ─────────────────────────
FAL_KEY=your_fal_api_key_here
# FAL_API_KEY is also accepted as a fallback

# ── Google Gmail (notifications + portfolio contact form) ──────────────────
# Register at: https://console.cloud.google.com → APIs & Services → Credentials
# Add redirect URI: http://localhost:8090/auth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Portfolio ──────────────────────────────────────────────────────────────
WHATSAPP_NUMBER=15551234567          # digits only, no + or spaces
PORTFOLIO_SECRET=changeme            # guards POST /api/revenue writes

# ── Transcription (Media Lab — optional, falls back to OpenAI/local) ───────
WHISPER_SERVER=http://localhost:9000  # whisper.cpp or faster-whisper server
OPENAI_API_KEY=                       # used for OpenAI Whisper API fallback

# ── Shorts Generator (AI-Youtube-Shorts-Generator integration) ─────────────
MUAPI_KEY=                            # optional: MuAPI cloud mode

# ── Ollama (local LLM — Ollama Studio) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
