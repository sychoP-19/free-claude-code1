# ── .env.example ──
# Copy to .env and fill in values

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=mistral:7b
LLM_BASE_URL=http://localhost:11434

# Cloud Avatar API (optional — leave empty for local-only)
HEYGEN_API_KEY=
DID_API_KEY=
SYNTHESIA_API_KEY=

# GPU
GPU_DEVICE=auto           # auto | cuda | rocm | mps | cpu
GPU_MEMORY_LIMIT_GB=
